# Vercel ignore file
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.git/
.gitignore
.env
.env.local
*.md
README.md
.vscode/
.idea/
*.swp
*.swo
*~

# AWS/Lambda-specific files (not needed for Vercel)

# Test files
tests/
test_*.py
*_test.py

# Exclude app directory from being treated as serverless functions
# (Vercel should only use api/ directory)
app/**/*.py
!app/**/__init__.py